{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "clang 编译当前文件",
      "type": "shell",
      "command": "/usr/bin/clang",
      "args": [
        "-Wall",
        "-g",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}
